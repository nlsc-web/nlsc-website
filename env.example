# PostgreSQL — required for contact form + admin portal messages
# Example: postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Gmail — required for admin portal "Reply by email"
# 1. Use the SAME Gmail account for GMAIL_USER and the App Password
# 2. Google Account → Security → 2-Step Verification ON → App passwords
# 3. Paste the 16-character password without spaces
GMAIL_USER=nextlevelsolutionscampus@gmail.com
GMAIL_APP_PASSWORD=abcdefghijklmnop

# Student Portal (LMS) — change these before production
PORTAL_SESSION_SECRET=change-this-to-a-long-random-secret
